## 5. DeepSeek Harness Plugin 接口

> 若 Harness 已有 Plugin 基類，以下接口作為適配層。若無，請生成 `HarnessPlugin` 抽象。

```python
class SelfLearningPlugin:
    def __init__(self, config: dict, harness):
        self.config = config
        self.harness = harness
        self.store = DiscoveryStore(config["discovery_db"])
        self.policy = load_policy(config["current_policy_path"])
        self.tool_registry = DynamicToolRegistry(config["tool_registry_path"])

    def on_task_start(self, task: dict) -> None:
        """記錄任務開始，載入當前策略。"""

    def before_action(self, state: dict) -> dict:
        """由當前 Policy 決定下一個 Action。"""
        return self.policy.select_action(state, self.store.get_tree(state["task_id"]))

    def after_action(self, state: dict, action: dict, result: dict) -> None:
        """將 LLM 輸出、沙盒結果、成本寫入 Discovery DAG。"""
        self.store.append_node(state, action, result)

    def on_task_end(self, task: dict, result: dict) -> None:
        """標記任務結束，觸發可選的增量工具合成。"""

    def evolve_offline(self, task_id: str | None = None) -> dict:
        """離線做夢：生成候選策略，回放評分，安全門，熱替換。"""
        return EvolutionLoop(self).run(task_id)

    def invoke_llm(self, prompt: str, **kwargs) -> str:
        """必須走 Harness LLM Client，便於凍結模型與記錄成本。"""
        return self.harness.llm.invoke(prompt, **kwargs)

    def run_tool(self, name: str, args: dict) -> Any:
        """必須走 Harness Tool Runtime 與沙盒。"""
        return self.harness.tools.run(name, args)
```

### 5.1 Policy 接口
```python
class Policy:
    def select_action(self, state: dict, tree: list[TreeNode]) -> dict: ...
    def expand(self, node: TreeNode, context: dict) -> list[dict]: ...
    def prune(self, node: TreeNode, stats: dict) -> bool: ...
    def schedule(self, workers: int, frontier: list[TreeNode]) -> dict: ...
    def score_candidate(self, candidate: dict) -> float: ...
